{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"configMigration": true,
	"extends": [
		"config:best-practices",
		":dependencyDashboard",
		":semanticPrefixFixDepsChoreOthers",
		":separateMultipleMajorReleases",
		":separateMajorReleases",
		":preserveSemverRanges",
		"group:monorepos",
		"replacements:all",
		"workarounds:all",
		"helpers:pinGitHubActionDigests",
		"docker:pinDigests"
	],
	"enabledManagers": [
		"dockerfile",
		"github-actions",
		"gomod",
		"mise"
	],
	"labels": ["dependencies", "renovate"],
	"timezone": "Asia/Tokyo",
	"minimumReleaseAge": "7 days",
	"schedule": ["* 9-11 * * 4"],
	"prHourlyLimit": 5,
	"rebaseWhen": "never",
	"postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
	"prBodyColumns": ["Package", "Update", "Change", "Package file", "Pending"],
	"packageRules": [
		{
			"description": "Bump the core go.mod directive instead of preserving stale Go versions",
			"matchManagers": ["gomod"],
			"matchDepNames": ["go"],
			"matchDepTypes": ["golang"],
			"rangeStrategy": "bump"
		},
		{
			"description": "Group core and repo maintenance non-major updates",
			"matchManagers": [
				"dockerfile",
				"github-actions",
				"gomod",
				"mise"
			],
			"matchFileNames": [
				".github/**",
				"Dockerfile",
				"core/go.mod",
				"core/mise.toml",
				"mise.toml"
			],
			"matchUpdateTypes": ["digest", "minor", "patch", "pin", "pinDigest"],
			"groupName": "core and repo maintenance non-major dependencies",
			"groupSlug": "core-repo-maintenance-minor-patch",
			"dependencyDashboardCategory": "Core",
			"addLabels": ["core", "tooling"]
		},
		{
			"description": "Label core major updates, but keep them as separate PRs",
			"matchManagers": ["gomod", "dockerfile"],
			"matchFileNames": ["core/go.mod", "Dockerfile"],
			"matchUpdateTypes": ["major"],
			"dependencyDashboardCategory": "Core",
			"addLabels": ["core", "major"]
		},
		{
			"description": "Label repo maintenance major updates, but keep them as separate PRs",
			"matchManagers": ["github-actions", "mise"],
			"matchFileNames": [
				".github/**",
				"core/mise.toml",
				"mise.toml"
			],
			"matchUpdateTypes": ["major"],
			"dependencyDashboardCategory": "Tooling",
			"addLabels": ["tooling", "major"]
		}
	],
	"vulnerabilityAlerts": {
		"enabled": true,
		"minimumReleaseAge": "0 days"
	}
}
